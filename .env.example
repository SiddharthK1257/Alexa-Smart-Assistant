# =================================================================
# Alexa+ Smart Assistant — Supabase Edition Environment Variables
# =================================================================
# Copy this file to .env and configure with your credentials.
# NEVER commit .env to version control.

# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Google Gemini API Configuration
# Get your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# YouTube Data API v3 Configuration
# Get your YouTube Data API v3 key from Google Cloud Console (https://console.cloud.google.com)
# 1. Create a project or select an existing one
# 2. Go to APIs & Services > Enable APIs and Services > Search for "YouTube Data API v3" and click Enable
# 3. Go to Credentials > Create Credentials > API Key (restrict to YouTube Data API v3 and IP/HTTP if desired)
# 4. Paste the API key below:
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# Supabase Project Configuration
# Found in Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key_if_applicable

# Direct PostgreSQL Connection String (for database migrations and server-side pooling)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres

# Model Context Protocol (MCP) Configuration
MCP_SERVER_NAME="Alexa+ Smart Assistant MCP Server"
MCP_SERVER_VERSION="1.0.0"
MCP_ENDPOINT_PATH="/mcp"

# OAuth 2.1 Configuration (for Amazon Alexa+ MCP Toolkit Account Linking)
# When registering with Amazon Alexa+ Add-on Developer Console:
OAUTH_ISSUER_URL=http://localhost:4000
OAUTH_CLIENT_ID=alexa-plus-client
OAUTH_CLIENT_SECRET=alexa-plus-secret-key-change-in-production
OAUTH_REDIRECT_URI=https://pitangui.amazon.com/api/skill/link/your-skill-id

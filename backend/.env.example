# ==============================================================================
# Alexa+ Smart Assistant — Backend Environment Template (.env.example)
# ==============================================================================

PORT=4000
NODE_ENV=production
FRONTEND_URL=https://alexa-smart-assistant.vercel.app

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# YouTube Data API v3 Configuration (Optional - enables official YouTube video search)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-pooler.supabase.com:6543/postgres

# MCP Server
MCP_SERVER_NAME="Alexa+ Smart Assistant MCP Server"
MCP_SERVER_VERSION="1.0.0"
MCP_ENDPOINT_PATH="/mcp"

# OAuth 2.1 Settings
OAUTH_ISSUER_URL=https://alexa-smart-assistant.onrender.com
OAUTH_CLIENT_ID=alexa-plus-client
OAUTH_CLIENT_SECRET=alexa-plus-secret-key-change-in-production
OAUTH_REDIRECT_URI=https://pitangui.amazon.com/api/skill/link/prototype
